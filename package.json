{
  "name": "openclaw-safe",
  "version": "0.1.0",
  "description": "Secure version of OpenClaw with proper security protocols for home use",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "check:boundaries": "node scripts/check_boundaries.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "jest": "29.7.0",
    "ts-jest": "29.3.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "better-sqlite3": "12.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"]
  }
}
