{
  "name": "openclaw-secure",
  "version": "1.0.0",
  "description": "A local-first agent operating system with policy broker, sandbox-first execution, durable tasks, and verifiable tool use.",
  "main": "dist/index.js",
  "bin": {
    "openclaw": "dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --forceExit",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-import-boundaries.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "commander": "^12.0.0",
    "express": "^4.18.3",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverage": false
  }
}
